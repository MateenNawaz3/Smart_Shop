      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se igen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nochmal ansehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch again"
          }
        }
      }
    },
    "guide.step" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trin"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Step"
          }
        }
      }
    },
    "guide.steps.0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på Smart Shop-ikonet på din telefon. Du behøver ikke gøre andet i appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf das Smart-Shop-Symbol. Mehr müssen Sie in der App nicht tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the Smart Shop icon on your phone. You don't need to do anything else in the app."
          }
        }
      }
    },
    "guide.steps.0.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen skal bare være åben — du skal ikke logge ind hver gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App muss nur geöffnet sein — Sie müssen sich nicht jedes Mal anmelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app just has to be open — you don't have to log in every time."
          }
        }
      }
    },
    "guide.steps.0.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Åbn appen på din telefon"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Öffnen Sie die App auf Ihrem Telefon"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Open the app on your phone"
          }
        }
      }
    },
    "guide.steps.1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold telefonens bagside helt tæt på den lille firkant ved døren. Hold den stille i 2 sekunder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die Rückseite Ihres Telefons dicht an das kleine Feld neben der Tür. 2 Sekunden ruhig halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the back of your phone close to the small square by the door. Keep it still for 2 seconds."
          }
        }
      }
    },
    "guide.steps.1.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der lyder et bip, og døren låser op. Så kan du trække i døren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es piept und die Tür entriegelt. Dann können Sie die Tür öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll hear a beep and the door unlocks. Then you can pull the door open."
          }
        }
      }
    },
    "guide.steps.1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Hold telefonen op til læseren ved døren"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Halten Sie das Telefon an den Leser an der Tür"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Hold the phone to the reader at the door"
          }
        }
      }
    },
    "guide.steps.2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå ind i butikken og tag de varer, du skal bruge, ned fra hylderne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehen Sie in den Laden und nehmen Sie die Waren aus dem Regal, die Sie brauchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk into the store and take the items you need from the shelves."
          }
        }
      }
    },
    "guide.steps.2.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag god tid. Butikken er åben hele døgnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassen Sie sich Zeit. Der Laden ist rund um die Uhr geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take your time. The store is open around the clock."
          }
        }
      }
    },
    "guide.steps.2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Find dine varer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Suchen Sie Ihre Waren aus"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Pick up your groceries"
          }
        }
      }
    },
    "guide.steps.3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold FØRST telefonen op til læseren ved kassen. Derefter scanner du dine varer og betaler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie ZUERST Ihr Telefon an den Leser an der Kasse. Danach scannen Sie Ihre Waren und bezahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIRST hold your phone to the reader at the checkout. Then scan your items and pay."
          }
        }
      }
    },
    "guide.steps.3.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk: telefonen først, så varerne. Når skærmen bliver grøn, er du færdig. God tur hjem!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merke: erst das Telefon, dann die Waren. Wenn der Bildschirm grün wird, sind Sie fertig. Gute Heimfahrt!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember: phone first, then the items. When the screen turns green, you're done. Safe trip home!"
          }
        }
      }
    },
    "guide.steps.3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Scan telefonen ved kassen — så varerne"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Telefon an der Kasse — dann die Waren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Tap your phone at the checkout — then scan"
          }
        }
      }
    },
    "guide.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sådan handler du"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So kaufen Sie ein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to shop here"
          }
        }
      }
    },
