    "tourist.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Shop 24-7 er ubemandede døgnbutikker i hele Danmark. Du går ind, finder dine varer og betaler selv — hele døgnet, året rundt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Shop 24-7 betreibt unbemannte 24-Stunden-Läden in ganz Dänemark. Reingehen, Waren aussuchen und selbst bezahlen — rund um die Uhr, das ganze Jahr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Shop 24-7 runs unstaffed 24-hour grocery stores across Denmark. Walk in, pick your items and pay by yourself — any hour, all year round."
          }
        }
      }
    },
