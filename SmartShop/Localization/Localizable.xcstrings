    "mitid.unavailableBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi flytter identitetstjek til et nyt system. Luk denne, og verificér i stedet med pas, kørekort eller ID-kort."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir stellen die Identitätsprüfung auf ein neues System um. Schließe dies und verifiziere dich stattdessen mit Reisepass, Führerschein oder Ausweis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We are moving identity checks to a new system. Close this and verify with a passport, driver's licence or ID card instead."
          }
        }
      }
