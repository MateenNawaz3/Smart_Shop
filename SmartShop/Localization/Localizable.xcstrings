            "state" : "translated",
            "value" : "Staying for a while?"
          }
        }
      }
    },
    "tourist.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bruger appen som gæst. Her er alt, du skal vide om at handle i en Smart Shop 24-7 butik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du nutzt die App als Gast. Hier findest du alles, was du zum Einkaufen in einem Smart Shop 24-7 wissen musst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are using the app as a guest. Here is everything you need to know about shopping at a Smart Shop 24-7 store."
          }
        }
      }
    },
