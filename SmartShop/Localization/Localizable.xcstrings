    "faq.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her er svar på det, vi oftest bliver spurgt om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier sind die Antworten auf die häufigsten Fragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answers to the questions we get asked most."
          }
        }
      }
    },
    "faq.items.0.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fleste Smart Shop 24-7 butikker er døgnåbne alle ugens dage. Enkelte butikker har begrænsede åbningstider — du kan altid se den aktuelle åbningstid på butikkens side under Find butik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Smart Shop 24-7 Filialen haben rund um die Uhr geöffnet, an allen Tagen. Einzelne Filialen haben eingeschränkte Öffnungszeiten — die aktuellen Zeiten findest du auf der Seite der Filiale unter „Filiale finden“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most Smart Shop 24-7 stores are open around the clock, every day. A few stores have limited opening hours — you can always see the current hours on the store's page under Find store."
          }
        }
      }
    },
    "faq.items.0.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvornår har butikkerne åbent?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann haben die Filialen geöffnet?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When are the stores open?"
          }
        }
      }
    },
    "faq.items.1.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du udfylder en aftale i butikken og får udleveret en nøglebrik. Brikken holdes op mod læseren ved døren, hvorefter du kan handle som normalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du füllst in der Filiale eine Vereinbarung aus und erhältst einen Schlüsselchip. Den Chip hältst du an den Leser an der Tür und kannst dann normal einkaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You fill in an agreement in the store and receive a key fob. Hold the fob against the reader at the door, and you can shop as normal."
          }
        }
      }
    },
    "faq.items.1.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan får jeg adgang med nøglebrik?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie bekomme ich Zugang mit dem Schlüsselchip?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do I get access with a key fob?"
          }
        }
      }
    },
    "faq.items.2.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du betaler ved selvbetjeningskassen med kort eller mobilbetaling. Du får din kvittering på skærmen og kan vælge at få den på mail."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bezahlst an der Selbstbedienungskasse mit Karte oder mobil. Den Beleg siehst du auf dem Bildschirm und kannst ihn dir per E-Mail schicken lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You pay at the self-service checkout by card or mobile payment. Your receipt appears on the screen and can be sent by email."
          }
        }
      }
    },
    "faq.items.2.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan betaler jeg?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie bezahle ich?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do I pay?"
          }
        }
      }
    },
    "faq.items.3.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja. Tryk på hjertet ved en butik under Find butik, så ligger den samlet under Mine favoritbutikker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja. Tippe bei einer Filiale unter „Filiale finden“ auf das Herz, dann findest du sie unter „Meine Lieblingsfilialen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. Tap the heart on a store under Find store, and it will be collected under My favourite stores."
          }
        }
      }
    },
    "faq.items.3.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan jeg gemme mine favoritbutikker?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann ich meine Lieblingsfilialen speichern?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can I save my favourite stores?"
          }
        }
      }
    },
    "faq.items.4.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå til Mere → Mine oplysninger. Her kan du opdatere navn, adresse og telefonnummer samt skifte adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe zu „Mehr“ → „Meine Daten“. Dort kannst du Name, Adresse und Telefonnummer aktualisieren und dein Passwort ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to More → My details. There you can update your name, address and phone number and change your password."
          }
        }
      }
    },
    "faq.items.4.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan retter jeg mine oplysninger?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie ändere ich meine Daten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do I update my details?"
          }
        }
      }
    },
    "faq.items.5.a" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug Kontakt-siden i appen, eller ring til den butik, det handler om. Kontaktoplysningerne står på butikkens side."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze die Kontaktseite in der App oder rufe die betreffende Filiale an. Die Kontaktdaten stehen auf der Seite der Filiale."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Contact page in the app, or call the store in question. The contact details are on the store's page."
          }
        }
      }
    },
    "faq.items.5.q" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
