    "tourist.ctaText" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en gratis konto og få adgang til ugens tilbud, favoritbutikker og opslagstavlen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle ein kostenloses Konto und erhalte Zugang zu Wochenangeboten, Lieblingsfilialen und der Pinnwand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a free account to unlock weekly offers, favourite stores and the local bulletin board."
          }
        }
      }
    },
    "tourist.ctaTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
