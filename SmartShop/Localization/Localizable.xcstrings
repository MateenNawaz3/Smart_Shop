    "howto.steps.1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hold bagsiden af din telefon tæt på den lille firkant ved døren. Hold den stille i 2 sekunder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
