    "tourist.howtoDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fem enkle trin — det tager under et minut at lære."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünf einfache Schritte — in weniger als einer Minute erklärt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five simple steps — it takes less than a minute to learn."
          }
        }
      }
    },
    "tourist.howtoSub" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trin for trin, fra døren til kvitteringen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritt für Schritt, von der Tür bis zum Kassenbon"
          }
        },
        "en" : {
