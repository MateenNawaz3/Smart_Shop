          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An wen wende ich mich, wenn etwas nicht klappt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who do I contact if something goes wrong?"
          }
        }
