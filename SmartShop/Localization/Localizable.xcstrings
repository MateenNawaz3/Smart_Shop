        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrænset åbningstid"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingeschränkte Öffnungszeiten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limited opening hours"
          }
        }
      }
    },
    "tourist.steps.0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vores butikker ligger i mindre byer og landsbyer. Brug Find en butik i appen for at se adresse og rutevejledning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsere Läden liegen in kleineren Städten und Dörfern. Nutze Filiale finden in der App für Adresse und Route."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our stores are in smaller towns and villages. Use Find a store in the app to see the address and get directions."
          }
        }
      }
    },
    "tourist.steps.0.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Find butikken"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Filiale finden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Find the store"
          }
        }
      }
    },
    "tourist.steps.1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Døren er åben hele døgnet. Nogle butikker låses op med en nøglebrik — hold den op mod læseren ved døren. Har du ikke en brik, kan du ringe til nummeret på døren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tür ist rund um die Uhr offen. Manche Läden öffnen mit einem Schlüsselchip — halte ihn an den Leser an der Tür. Ohne Chip: Ruf die Nummer an der Tür an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The door is open around the clock. Some stores unlock with a key fob — hold it against the reader by the door. No fob? Call the number on the door."
          }
        }
      }
    },
    "tourist.steps.1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Gå ind"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Hineingehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Go inside"
          }
        }
      }
    },
    "tourist.steps.2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butikken har alt det daglige: mælk, brød, kød, frugt, drikkevarer og lidt til den søde tand. Priserne står ved hylden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du findest alles für den Alltag: Milch, Brot, Fleisch, Obst, Getränke und etwas Süßes. Die Preise stehen am Regal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll find the everyday basics: milk, bread, meat, fruit, drinks and a few treats. Prices are shown on the shelf."
          }
        }
      }
    },
    "tourist.steps.2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Find dine varer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Waren aussuchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Pick your items"
          }
        }
      }
    },
    "tourist.steps.3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan hver vare ved selvbetjeningskassen og betal med kort eller mobil. Udenlandske kort accepteres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne jede Ware an der Selbstbedienungskasse und zahle mit Karte oder Handy. Ausländische Karten werden akzeptiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan each item at the self-checkout and pay by card or mobile. Foreign cards are accepted."
          }
        }
      }
    },
    "tourist.steps.3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Scan og betal selv"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Selbst scannen und bezahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Scan and pay yourself"
          }
        }
      }
    },
    "tourist.steps.4.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får kvitteringen på skærmen og kan vælge at få den på mail. Så er du klar til at gå — god handel!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bon erscheint auf dem Bildschirm und kann per E-Mail verschickt werden. Fertig — viel Spaß!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The receipt appears on screen and can be sent to your email. That's it — enjoy your stay!"
          }
        }
      }
    },
    "tourist.steps.4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. Tag din kvittering"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. Kassenbon mitnehmen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. Take your receipt"
          }
        }
      }
    },
