    "about.data" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi gemmer kun de oplysninger, du selv indtaster: navn, adresse, telefonnummer og e-mail. Vi sælger aldrig dine data videre, og du kan til enhver tid få dem rettet eller slettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir speichern nur die Angaben, die du selbst eingibst: Name, Adresse, Telefonnummer und E-Mail. Wir verkaufen deine Daten niemals weiter, und du kannst sie jederzeit korrigieren oder löschen lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We only store the information you enter yourself: name, address, phone number and email. We never sell your data, and you can have it corrected or deleted at any time."
          }
        }
      }
    },
    "about.dataTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persondata"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personenbezogene Daten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal data"
          }
        }
      }
    },
    "about.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Shop 24-7 er din lokale butik — altid åben. Vi driver ubemandede døgnbutikker rundt om i landet, så du kan handle dagligvarer, når det passer dig. I appen finder du ugens favorittilbud, dine favoritbutikker, åbningstider og rutevejledning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Shop 24-7 ist dein Laden vor Ort — immer geöffnet. Wir betreiben unbemannte 24/7-Läden im ganzen Land, damit du einkaufen kannst, wann es dir passt. In der App findest du die Angebote der Woche, deine Lieblingsfilialen, Öffnungszeiten und die Route."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Shop 24-7 is your local shop — always open. We run unstaffed 24/7 stores across the country so you can buy groceries whenever it suits you. In the app you'll find the offers of the week, your favourite stores, opening hours and directions."
          }
        }
      }
    },
    "about.mission.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som i mange andre udviklede lande har små byer og landdistrikter i stigende grad oplevet butikslukninger, hvor de sidste lokale købmandsforretninger forsvinder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie in vielen anderen Industrieländern erleben kleine Orte und ländliche Gebiete zunehmend Ladenschließungen, bei denen die letzten örtlichen Kaufleute verschwinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As in many other developed countries, small towns and rural areas have increasingly seen shop closures, with the last local grocers disappearing."
          }
        }
      }
    },
    "about.mission.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De store detailkæder centraliserer deres drift i byerne, mens online dagligvarelevering sjældent når ud til de mindre lokalsamfund. Resultatet er reelle fødevareørkener – hvor beboerne ofte må køre mere end 10 km for at få adgang til helt basale dagligvarer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die großen Handelsketten zentralisieren ihren Betrieb in den Städten, während die Online-Lieferung von Lebensmitteln kleinere Gemeinden selten erreicht. Das Ergebnis sind echte Lebensmittelwüsten – Bewohner müssen oft mehr als 10 km fahren, um Grundnahrungsmittel zu bekommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The large retail chains centralise their operations in the cities, while online grocery delivery rarely reaches smaller communities. The result is real food deserts – where residents often have to drive more than 10 km to get basic groceries."
          }
        }
      }
    },
    "about.mission.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne udvikling skader ikke bare livskvaliteten, men undergraver også den sociale sammenhængskraft og økonomiske aktivitet i landdistrikterne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Entwicklung schadet nicht nur der Lebensqualität, sie untergräbt auch den sozialen Zusammenhalt und die wirtschaftliche Aktivität auf dem Land."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This development not only harms quality of life, it also undermines social cohesion and economic activity in rural areas."
          }
        }
      }
    },
    "about.mission.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale myndigheder, kommuner og borgergrupper efterspørger i stigende grad praktiske og skalerbare løsninger til at genetablere den lokale købmand. Men traditionelle butikker med bemanding er sjældent rentable i disse områder på grund af lav kundetrafik, høje lønomkostninger og begrænsede åbningstider."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behörden, Kommunen und Bürgergruppen fragen zunehmend nach praktischen und skalierbaren Lösungen, um den örtlichen Laden wieder aufzubauen. Traditionelle Läden mit Personal sind in diesen Gebieten jedoch wegen geringer Kundenfrequenz, hoher Lohnkosten und begrenzter Öffnungszeiten selten rentabel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local authorities, municipalities and citizen groups increasingly ask for practical and scalable solutions to re-establish the local grocer. But traditional staffed shops are rarely profitable in these areas because of low customer traffic, high wage costs and limited opening hours."
          }
        }
      }
    },
    "about.mission.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Shop 24-7 løser dette behov direkte ved at etablere automatiserede, kompakte dagligvarebutikker, som er nemme at opsætte og kan holde åbent døgnet rundt – helt uden lokalt personale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Shop 24-7 löst diesen Bedarf direkt mit automatisierten, kompakten Lebensmittelläden, die einfach aufzustellen sind und rund um die Uhr geöffnet haben – ganz ohne Personal vor Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Shop 24-7 solves this need directly by setting up automated, compact grocery stores that are easy to install and can stay open around the clock – with no local staff at all."
          }
        }
      }
    },
    "about.mission.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den avancerede teknologi bag gør det muligt at drive butikkerne effektivt, selv i områder, hvor traditionelle supermarkeder ikke længere kan få økonomien til at hænge sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die fortschrittliche Technik dahinter macht es möglich, die Läden effizient zu betreiben, selbst dort, wo klassische Supermärkte nicht mehr wirtschaftlich arbeiten können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The advanced technology behind them makes it possible to run the stores efficiently, even in areas where traditional supermarkets can no longer make the economics work."
          }
        }
      }
    },
