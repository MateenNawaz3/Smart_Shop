    "signup.unavailable.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi flytter oprettelse af konto til et nyt system, så den er slået fra i appen lige nu. Spørg i din Smart Shop, eller log ind nedenfor, hvis du allerede har en konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir stellen die Kontoerstellung auf ein neues System um, daher ist sie in der App vorerst deaktiviert. Frag in deinem Smart Shop nach oder melde dich unten an, wenn du bereits ein Konto hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We are moving account creation to a new system, so it is switched off in the app for now. Ask in your Smart Shop, or log in below if you already have an account."
          }
        }
      }
    },
    "signup.unavailable.title" : {
      "extractionState" : "manual",
