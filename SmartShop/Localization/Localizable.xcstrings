    "tourist.gtkDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktisk information til dig, der er på besøg i Danmark."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktische Informationen für deinen Besuch in Dänemark."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practical information for visitors to Denmark."
          }
        }
      }
    },
    "tourist.gtkItems.0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fleste butikker har åbent 24 timer i døgnet, alle ugens dage — også på helligdage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Filialen sind 24 Stunden am Tag geöffnet, an allen Wochentagen — auch an Feiertagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most stores are open 24 hours a day, every day of the week — including public holidays."
          }
        }
      }
    },
    "tourist.gtkItems.0.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbent hele døgnet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rund um die Uhr geöffnet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open around the clock"
          }
        }
      }
    },
    "tourist.gtkItems.1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ingen kontanter i butikkerne. Du betaler med betalingskort eller mobilbetaling ved selvbetjeningskassen. Danske og udenlandske kort accepteres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den Läden gibt es kein Bargeld. Du zahlst mit Karte oder Handy an der Selbstbedienungskasse. Dänische und ausländische Karten werden akzeptiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no cash in the stores. Pay by debit/credit card or mobile payment at the self-checkout. Danish and foreign cards are accepted."
          }
        }
      }
    },
    "tourist.gtkItems.1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betaling"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezahlung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payment"
          }
        }
      }
    },
    "tourist.gtkItems.2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danske flasker og dåser har pant. Pantautomaten står typisk ved indgangen — du får en bon, du kan bruge som betaling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dänische Flaschen und Dosen wird Pfand erhoben. Der Pfandautomat steht meist am Eingang und druckt einen Bon, den du als Zahlung nutzen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danish bottles and cans carry a refundable deposit (pant). The return machine is usually by the entrance and prints a voucher you can use as payment."
          }
        }
      }
    },
    "tourist.gtkItems.2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pant på flasker og dåser"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfand auf Flaschen und Dosen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deposit on bottles and cans"
          }
        }
      }
    },
    "tourist.gtkItems.3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skal være 16 år for at købe øl og vin, og 18 år for spiritus og tobak. Der kan blive bedt om legitimation ved kassen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Bier und Wein musst du 16 Jahre alt sein, für Spirituosen und Tabak 18. An der Kasse kann ein Ausweis verlangt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must be 16 to buy beer and wine, and 18 for spirits and tobacco. You may be asked for ID at the checkout."
          }
        }
      }
    },
    "tourist.gtkItems.3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkohol og tobak"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkohol und Tabak"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcohol and tobacco"
          }
        }
      }
    },
    "tourist.gtkItems.4.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virker kassen ikke, eller mangler du hjælp? Ring til +45 70 22 03 60, eller brug Kontakt-siden i appen. Der er kameraovervågning i alle butikker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasse defekt oder brauchst du Hilfe? Ruf +45 70 22 03 60 an oder nutze die Kontaktseite in der App. Alle Filialen sind videoüberwacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkout not working, or need a hand? Call +45 70 22 03 60 or use the Contact page in the app. All stores are video monitored."
          }
        }
      }
    },
    "tourist.gtkItems.4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis noget går galt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn etwas nicht klappt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If something goes wrong"
          }
        }
      }
    },
